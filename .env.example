# ============================================
# CONFIGURACIÓN BITÁCORA SOLAR
# Copia este archivo como .env.local y completa
# ============================================

# --- FIREBASE ---
# Ve a https://console.firebase.google.com
# → Tu proyecto → ⚙ Configuración → Aplicaciones → Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- GROQ (GRATUITA - para mejorar redacción Y escanear fotos) ---
# Ve a https://console.groq.com → API Keys → Create API Key
# Modelo de texto: llama3-8b-8192
# Modelo de visión: meta-llama/llama-4-scout-17b-16e-instruct
GROQ_API_KEY=

# --- CLOUDINARY (para subir imágenes y videos en Procedimientos) ---
# Ve a https://cloudinary.com → Settings → Upload → Upload presets → Add unsigned preset
# Cloud name y API keys en Settings → API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
